# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Supabase Project URL or Project ID (e.g. apvkdnofstyyidcmuczb or https://apvkdnofstyyidcmuczb.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=apvkdnofstyyidcmuczb

# Supabase Public / Anonymous Key (browser-safe)
# Supports both Vercel Supabase integration standard name and Supabase publishable key format:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Privileged Service-Role Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
# Supports standard Vercel Supabase integration name and local secret key name:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Optional Notification Webhook
NOTIFICATION_WEBHOOK_URL=

# ==============================================================================
# Email Forwarding Configuration (Resend API)
# ==============================================================================
# Server-side API key for sending email notifications on website inquiries
# Sign up at https://resend.com and obtain an API key (e.g. re_...)
RESEND_API_KEY=
# Recipient email address for new contact inquiries
CONTACT_EMAIL_TO=contact@seedengineering.com
# Verified sender email address (e.g. 'SEED Inquiries <noreply@yourdomain.com>')
CONTACT_EMAIL_FROM=

